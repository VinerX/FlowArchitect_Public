{
  "flowContents": {
    "identifier": "7a06530e-8a37-498d-bfc2-e15585b1a235",
    "name": "Log Ingestion Pipeline",
    "comments": "Fetch JSON logs from S3 bucket raw-logs every hour, add processed_at timestamp, load into PostgreSQL public.event_log",
    "processors": [
      {
        "identifier": "cc2d7f37-99e8-4d10-9cc0-4f11c041d168",
