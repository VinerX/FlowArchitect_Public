            "name": "Exchange Rate API"
          },
          "destination": {
            "id": "e3c3c3c3-0003-1000-0000-000000000003",
            "type": "PROCESSOR",
            "groupId": "8937007c-0001-1000-0000-000000000000",
            "name": "Rename to rates.json"
          },
          "selectedRelationships": [
            "Response"
          ]
        },
        {
          "id": "c2e2e2e2-0005-1000-0000-000000000005",
          "name": "Write to File",
          "source": {
            "id": "e3c3c3c3-0003-1000-0000-000000000003",
            "type": "PROCESSOR",
            "groupId": "8937007c-0001-1000-0000-000000000000",
            "name": "Rename to rates.json"
          },
          "destination": {
            "id": "e2b2b2b2-0002-1000-0000-000000000002",
            "type": "PROCESSOR",
            "groupId": "8937007c-0001-1000-0000-000000000000",
            "name": "Local JSON File"
          },
