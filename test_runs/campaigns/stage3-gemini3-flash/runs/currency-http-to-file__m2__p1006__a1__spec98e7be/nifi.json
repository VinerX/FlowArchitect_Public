  "component": {
    "id": "8937007c-0001-1000-0000-000000000000",
    "name": "Exchange Rate to JSON Flow",
    "description": "Fetches latest exchange rates from an API and saves them to a local JSON file.",
    "contents": {
      "processors": [
        {
          "id": "e1a1a1a1-0001-1000-0000-000000000001",
          "name": "Exchange Rate API",
          "type": "org.apache.nifi.processors.standard.InvokeHTTP",
          "bundle": {
            "group": "org.apache.nifi",
            "artifact": "nifi-standard-nar",
            "version": "1.23.2"
          },
          "position": {
            "x": 300.0,
            "y": 100.0
          },
          "config": {
            "schedulingStrategy": "CRON_DRIVEN",
            "schedulingPeriod": "0 0 * * *",
            "properties": {
              "HTTP Method": "GET",
              "Remote URL": "https://api.exchangerate.host/latest",
              "Connection Timeout": "5 secs",
              "Read Timeout": "15 secs"
            }
          }
        },
        {
          "id": "e2b2b2b2-0002-1000-0000-000000000002",
          "name": "Local JSON File",
          "type": "org.apache.nifi.processors.standard.PutFile",
          "bundle": {
            "group": "org.apache.nifi",
            "artifact": "nifi-standard-nar",
            "version": "1.23.2"
          },
          "position": {
            "x": 300.0,
            "y": 400.0
          },
          "config": {
            "properties": {
              "Directory": "/data/output",
              "Conflict Resolution Strategy": "replace"
            }
          }
        },
        {
          "id": "e3c3c3c3-0003-1000-0000-000000000003",
          "name": "Rename to rates.json",
          "type": "org.apache.nifi.processors.standard.UpdateAttribute",
          "bundle": {
            "group": "org.apache.nifi",
            "artifact": "nifi-update-attribute-nar",
            "version": "1.23.2"
          },
          "position": {
            "x": 300.0,
            "y": 250.0
          },
          "config": {
            "properties": {
              "filename": "rates.json"
            }
          }
        }
      ],
      "connections": [
        {
          "id": "c1d1d1d1-0004-1000-0000-000000000004",
          "name": "API Success",
          "source": {
            "id": "e1a1a1a1-0001-1000-0000-000000000001",
