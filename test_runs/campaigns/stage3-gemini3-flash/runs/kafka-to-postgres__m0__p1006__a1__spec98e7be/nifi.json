        }
      },
      {
        "identifier": "put-sql",
        "name": "PutSQL",
        "type": "org.apache.nifi.processors.standard.PutSQL",
        "bundle": {
          "group": "org.apache.nifi",
          "artifact": "nifi-standard-nar",
          "version": "1.23.2"
        },
        "properties": {
          "JDBC Connection Pool": "PostgreSQL-Connection-Pool"
        }
      }
    ],
    "connections": [
      {
        "identifier": "conn-1",
        "source": {
          "id": "consume-kafka",
          "type": "PROCESSOR"
        },
        "destination": {
          "id": "convert-json-to-sql",
          "type": "PROCESSOR"
        },
        "selectedRelationships": [
          "success"
        ]
      },
      {
        "identifier": "conn-2",
        "source": {
          "id": "convert-json-to-sql",
          "type": "PROCESSOR"
        },
        "destination": {
          "id": "put-sql",
          "type": "PROCESSOR"
        },
        "selectedRelationships": [
          "success"
        ]
      }
    ],
    "controllerServices": [
