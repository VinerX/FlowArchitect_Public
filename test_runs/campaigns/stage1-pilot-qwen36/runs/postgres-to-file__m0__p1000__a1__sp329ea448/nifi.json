{
  "flow": {
    "processGroups": [
      {
        "id": "pg-export-orders",
        "name": "PostgreSQL to JSON Export",
        "position": {
          "x": 0,
          "y": 0
        },
        "processors": [
          {
            "id": "proc-query-db",
            "name": "QueryDatabaseTableRecord",
            "type": "org.apache.nifi.processors.standard.QueryDatabaseTableRecord",
            "position": {
              "x": 100,
              "y": 100
            },
            "config": {
              "schedulingStrategy": "TIMER_DRIVEN",
              "schedulingPeriod": "5 min",
              "properties": {
                "database-connection-pooling-service": "dbcp-pool",
                "table-name": "public.orders",
                "maximum-value-columns": "id",
                "record-writer": "json-writer",
                "statefully-track": "true"
              },
              "autoTerminatedRelationships": []
            }
          },
          {
            "id": "proc-put-file",
            "name": "PutFile",
            "type": "org.apache.nifi.processors.standard.PutFile",
            "position": {
              "x": 100,
              "y": 300
            },
            "config": {
              "schedulingStrategy": "TIMER_DRIVEN",
              "schedulingPeriod": "0 sec",
              "properties": {
                "Directory": "./output",
                "Conflict Resolution Strategy": "replace",
                "Filename": "orders_export.json"
              },
              "autoTerminatedRelationships": [
                "success",
                "failure"
              ]
            }
          }
        ],
        "connections": [
          {
            "id": "conn-query-to-file",
            "name": "Query to File",
            "source": {
              "id": "proc-query-db",
              "type": "PROCESSOR",
              "groupId": "pg-export-orders"
            },
            "destination": {
              "id": "proc-put-file",
              "type": "PROCESSOR",
              "groupId": "pg-export-orders"
            },
            "selectedRelationships": [
              "success"
            ],
            "backPressureObjectThreshold": 10000,
            "backPressureDataSizeThreshold": "1 GB"
          }
        ],
        "controllerServices": [
          {
            "id": "dbcp-pool",
            "name": "PostgreSQL DBCPConnectionPool",
            "type": "org.apache.nifi.dbcp.DBCPConnectionPool",
            "properties": {
              "Database Driver Location": "",
              "Database Driver Class Name": "org.postgresql.Driver",
              "Database Connection URL": "jdbc:postgresql://localhost:5432/mydb",
              "Database User": "postgres",
              "Password": "postgres"
            },
            "state": "ENABLED"
          },
          {
            "id": "json-writer",
            "name": "JsonRecordSetWriter",
            "type": "org.apache.nifi.json.JsonRecordSetWriter",
            "properties": {
              "Schema Access Strategy": "Inherit Record Schema"
            },
            "state": "ENABLED"
          }
        ]
      }
    ]
  }
}