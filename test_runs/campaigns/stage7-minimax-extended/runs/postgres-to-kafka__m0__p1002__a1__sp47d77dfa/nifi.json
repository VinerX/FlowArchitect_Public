{
  "flow": {
    "name": "PendingTransactionsToKafka",
    "description": "Read PENDING transactions from PostgreSQL and publish to Kafka",
    "processors": [
      {
        "id": "execute-sql-pending",
        "type": "ExecuteSQL",
        "name": "FetchPendingTransactions",
        "properties": {
          "Database Connection Pooling Service": "dbcp-datasource",
          "SQL SELECT Query": "SELECT id, amount, currency, status, created_at, updated_at FROM public.transactions WHERE status = 'PENDING'",
          "Max Wait Time": "30 seconds",
          "Fetch Size": "1000"
        },
        "scheduling": {
          "schedulingStrategy": "TIMER_DRIVEN",
          "runSchedule": "0 */5 * * * ?"
        }
      },
      {
        "id": "convert-to-json",
        "type": "ConvertRecord",
        "name": "ConvertToJSON",
        "properties": {
          "Record Reader": "avro-reader",
          "Record Writer": "json-record-writer"
        }
      },
      {
        "id": "publish-kafka",
        "type": "PublishKafkaRecord",
        "name": "PublishToKafka",
        "properties": {
          "Kafka Brokers": "${kafka.brokers}",
          "Topic": "transactions.overdue",
          "Record Reader": "json-reader",
          "Record Writer": "kafka-json-writer",
          "Use Transactions": "true",
          "acks": "all",
          "retries": "3"
        }
      }
    ],
    "controllerServices": [
      {
        "id": "dbcp-datasource",
        "type": "DBCPConnectionPool",
        "name": "PostgreSQLConnection",
        "properties": {
          "Database Driver Class Name": "org.postgresql.Driver",
          "Database Driver URLs": "jdbc:postgresql://${postgres.host}:${postgres.port}/${postgres.database}",
          "Database User": "${postgres.username}",
          "Password": "${postgres.password}",
          "Maximum Pool Size": "10"
        }
      },
      {
        "id": "avro-reader",
        "type": "AvroRecordReader",
        "name": "AvroReader"
      },
      {
        "id": "json-record-writer",
        "type": "JsonRecordSetWriter",
        "name": "JSONWriter",
        "properties": {
          "Schema Write Strategy": "hwx-schema-ref-tenant",
          "Output Grouping": "ARRAY"
        }
      },
      {
        "id": "json-reader",
        "type": "JsonPathReader",
        "name": "JSONReader",
        "properties": {
          "JsonPath Expression": "$.*"
        }
      },
      {
        "id": "kafka-json-writer",
        "type": "JsonRecordSetWriter",
        "name": "KafkaJSONWriter",
        "properties": {
          "Schema Write Strategy": "do-not-use-schema"
        }
      }
    ],
    "connections": [
      {
        "id": "sql-to-convert",
        "sourceId": "execute-sql-pending",
        "targetId": "convert-to-json",
        "relationship": "Success"
      },
      {
        "id": "convert-to-kafka",
        "sourceId": "convert-to-json",
        "targetId": "publish-kafka",
        "relationship": "success"
      }
    ],
    "variables": {
      "kafka.brokers": "kafka:9092",
      "postgres.host": "postgres",
      "postgres.port": "5432",
      "postgres.database": "payments",
      "postgres.username": "nifi_user"
    }
  }
}