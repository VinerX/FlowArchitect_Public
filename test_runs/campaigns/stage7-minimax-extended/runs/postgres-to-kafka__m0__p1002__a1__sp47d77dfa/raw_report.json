                "Database User": "${postgres.username}",
                "Password": "${postgres.password}",
                "Maximum Pool Size": "10"
              }
            },
            {
              "id": "avro-reader",
              "type": "AvroRecordReader",
              "name": "AvroReader"
            },
            {
              "id": "json-record-writer",
              "type": "JsonRecordSetWriter",
              "name": "JSONWriter",
              "properties": {
                "Schema Write Strategy": "hwx-schema-ref-tenant",
                "Output Grouping": "ARRAY"
              }
            },
            {
              "id": "json-reader",
              "type": "JsonPathReader",
              "name": "JSONReader",
              "properties": {
                "JsonPath Expression": "$.*"
              }
            },
            {
              "id": "kafka-json-writer",
              "type": "JsonRecordSetWriter",
              "name": "KafkaJSONWriter",
              "properties": {
                "Schema Write Strategy": "do-not-use-schema"
              }
            }
          ],
          "connections": [
            {
              "id": "sql-to-convert",
