      "yaml_pim": "flow:\n  id: s3_json_to_postgres\n  name: S3 JSON to PostgreSQL ETL\n  description: Read JSON files from S3 raw-logs bucket hourly, enrich with processed_at\n    timestamp, and load into PostgreSQL event_log table\ntriggers:\n- id: trigger_hourly\n  type: schedule\n  condition: every 1 hour\nsources:\n- id: source_s3\n  name: Read JSON from S3\n  type: S3\n  location: raw-logs\n  connection:\n    properties:\n      bucket: raw-logs\n      region: '{{AWS_REGION}}'\n      access_key_id: '{{AWS_ACCESS_KEY_ID}}'\n      secret_access_key: '{{AWS_SECRET_ACCESS_KEY}}'\nprocessing_elements:\n- id: process_enrich\n  name: Add processed_at timestamp\n  operation: AddField\n  config:\n    field_name: processed_at\n    value: '{{CURRENT_TIMESTAMP}}'\nsinks:\n- id: sink_postgres\n  name: Write to PostgreSQL\n  type: PostgreSQL\n  location: public.event_log\n  connection:\n    properties:\n      host: '{{DB_HOST}}'\n      port: '{{DB_PORT}}'\n      database: '{{DATABASE_NAME}}'\n      username: '{{DB_USERNAME}}'\n      password: '{{DB_PASSWORD}}'\nprocessed_data:\n- id: event_json\n  format: json\nlinks:\n- from_id: source_s3\n  to_id: process_enrich\n  data_ref: event_json\n- from_id: process_enrich\n  to_id: sink_postgres\n  data_ref: event_json",
