          "position": {
            "x": 200,
            "y": 200
          },
          "config": {
            "schedulingStrategy": "TIMER_DRIVEN",
            "schedulingPeriod": "1 hour",
            "penaltyDuration": "30 sec",
            "yieldDuration": "1 sec",
            "bulletinLevel": "WARN",
            "runDurationMillis": 0,
            "concurrentlySchedulableTaskCount": 1,
            "autoTerminatedRelationships": [
              "No Retry",
              "Retry",
              "Failure"
            ],
            "properties": {
              "HTTP Method": "GET",
              "HTTP URL": "https://api.exchangerate.host/latest",
              "Request Headers": "{}",
              "Connection Timeout": "30 sec",
              "Read Timeout": "30 sec",
              "SSL Context Service": null,
              "Proxy Host": null,
              "Proxy Port": null,
              "Content-Type": "application/json",
              "Send Message Body": "false",
              "Response Body Ignored": "false",
              "Put Response Body In Attribute": null,
              "Max Length To Put In Attribute": "256",
              "Digest Authentication": "false",
              "Always Output Response": "false",
              "Add Response Headers to Request": "false",
              "Use Chunked Encoding": "false",
              "Penalize on \"No Retry\"": "false",
              "Follow Redirects": "true"
            }
          }
        },
        {
          "id": "11111111-1111-1111-1111-111111111102",
          "name": "Parse API Response",
          "type": "org.apache.nifi.processors.standard.EvaluateJsonPath",
          "position": {
            "x": 500,
            "y": 200
          },
          "config": {
            "schedulingStrategy": "TIMER_DRIVEN",
            "schedulingPeriod": "0 sec",
            "penaltyDuration": "30 sec",
            "yieldDuration": "1 sec",
            "bulletinLevel": "WARN",
            "runDurationMillis": 0,
            "concurrentlySchedulableTaskCount": 1,
            "autoTerminatedRelationships": [
              "failure",
              "unmatched"
            ],
            "properties": {
              "Destination": "flowfile-attribute",
              "Return Type": "auto-detect",
              "Path Not Found Behavior": "ignore",
              "Null Value Representation": "empty string",
              "json.base": "$.base",
              "json.date": "$.date",
              "json.rates": "$.rates",
              "json.success": "$.success"
            }
          }
        },
        {
          "id": "11111111-1111-1111-1111-111111111103",
          "name": "Transform Rates Data",
          "type": "org.apache.nifi.processors.standard.UpdateAttribute",
          "position": {
            "x": 800,
            "y": 200
          },
          "config": {
            "schedulingStrategy": "TIMER_DRIVEN",
