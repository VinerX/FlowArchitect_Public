      "yaml_pim": "flow:\n  id: events_routing_pipeline\n  name: Events Routing Pipeline\n  description: Read messages from Kafka topic events.all, route purchases to PostgreSQL\n    purchases table, refunds to PostgreSQL refunds table, and everything else to Kafka\n    topic events.unknown\ntriggers:\n- id: trigger_main\n  type: event\n  condition: new message in Kafka topic events.all\nsources:\n- id: source_events_all\n  name: Read from Kafka events.all\n  type: Kafka\n  location: events.all\n  connection:\n    properties:\n      brokers: '{{KAFKA_BROKERS}}'\n      group_id: '{{KAFKA_CONSUMER_GROUP_ID}}'\n      auto_offset_reset: earliest\nprocessing_elements:\n- id: process_deserialize\n  name: Deserialize Event Message\n  operation: Deserialize\n  config:\n    format: json\n    field_mapping: type, *\n- id: process_route_purchase\n  name: Filter Purchase Events\n  operation: Filter\n  config:\n    condition: type == 'purchase'\n- id: process_route_refund\n  name: Filter Refund Events\n  operation: Filter\n  config:\n    condition: type == 'refund'\n- id: process_route_unknown\n  name: Filter Unknown Events\n  operation: Filter\n  config:\n    condition: type != 'purchase' AND type != 'refund'\nsinks:\n- id: sink_postgres_purchases\n  name: Write to PostgreSQL purchases\n  type: PostgreSQL\n  location: public.purchases\n  connection:\n    properties:\n      host: '{{DB_HOST}}'\n      port: '{{DB_PORT}}'\n      database: '{{DATABASE_NAME}}'\n      username: '{{DB_USERNAME}}'\n      password: '{{DB_PASSWORD}}'\n- id: sink_postgres_refunds\n  name: Write to PostgreSQL refunds\n  type: PostgreSQL\n  location: public.refunds\n  connection:\n    properties:\n      host: '{{DB_HOST}}'\n      port: '{{DB_PORT}}'\n      database: '{{DATABASE_NAME}}'\n      username: '{{DB_USERNAME}}'\n      password: '{{DB_PASSWORD}}'\n- id: sink_kafka_unknown\n  name: Write to Kafka events.unknown\n  type: Kafka\n  location: events.unknown\n  connection:\n    properties:\n      brokers: '{{KAFKA_BROKERS}}'\nprocessed_data:\n- id: event_raw\n  format: json\n- id: event_purchase\n  format: json\n- id: event_refund\n  format: json\n- id: event_unknown\n  format: json\nlinks:\n- from_id: source_events_all\n  to_id: process_deserialize\n  data_ref: event_raw\n- from_id: process_deserialize\n  to_id: process_route_purchase\n  data_ref: event_raw\n- from_id: process_deserialize\n  to_id: process_route_refund\n  data_ref: event_raw\n- from_id: process_deserialize\n  to_id: process_route_unknown\n  data_ref: event_raw\n- from_id: process_route_purchase\n  to_id: sink_postgres_purchases\n  data_ref: event_purchase\n- from_id: process_route_refund\n  to_id: sink_postgres_refunds\n  data_ref: event_refund\n- from_id: process_route_unknown\n  to_id: sink_kafka_unknown\n  data_ref: event_unknown",
